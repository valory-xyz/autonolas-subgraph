# local development defaults — copy to .env and fill in the secrets
DB_NAME=squid
DB_USER=postgres
DB_PASS=postgres
# 23802, so a local mech-fees DB can run alongside the other squids
# (predict-polymarket 23798, pearl-transactions 23799, service-registry 23800, liquidity 23801)
DB_PORT=23802
DB_HOST=localhost
# Which CHAINS entry in src/constants.ts this deployment indexes (default robinhood)
MECH_FEES_CHAIN=robinhood
# Where blocks come from: portal (needs the private dataset URL + key below) or rpc.
INGEST_SOURCE=rpc
# robinhood-mainnet is a PRIVATE SQD Portal dataset: both values come from infra.
SQD_PORTAL_URL=https://portal.sqd.dev/datasets/robinhood-mainnet
SQD_PORTAL_API_KEY=
# JSON-RPC for the Chainlink read at each fee event's block (and ingestion when
# INGEST_SOURCE=rpc). Archive-capable for a backfill; the public
# rpc.mainnet.chain.robinhood.com is pruned and falls back to the current price.
RPC_HTTP=https://rpc-gate.autonolas.tech/robinhood-rpc/
# Optional: index up to this block and exit (validation runs only)
# MECH_FEES_END_BLOCK=
