# local development defaults — copy to .env and fill in the secrets
DB_NAME=squid
DB_USER=postgres
DB_PASS=postgres
# 23799, so a local pearl-transactions DB can run alongside predict-polymarket's 23798
DB_PORT=23799
DB_HOST=localhost
# Chain this deployment indexes: matic (default), base, gnosis, optimism.
# An unknown name fails at startup.
PEARL_TRANSACTIONS_CHAIN=matic
# RPC for the selected chain, used for the Safe getOwners/getThreshold
# calls. MUST be archive-capable: owners are read at each Safe's
# first-sighting block, which during backfill is millions of blocks old.
# RPC_POLYGON_HTTP / RPC_POLYGON_HTTP_FALLBACK are still read as aliases on
# matic only; on any other chain, setting one fails at startup.
RPC_HTTP=https://polygon-rpc.com
# Second archive endpoint, used only when the primary fails with a non-revert
# error (e.g. a hole in its archive). Sees a handful of calls, so a
# rate-limited public endpoint is fine. Set it in production.
RPC_HTTP_FALLBACK=
# SQD Portal dataset URL. The default public portal needs no key and is
# heavily rate-limited (HTTP 529) — fine for a smoke test, not for a
# backfill. Production overrides both vars with the private portal.
SQD_PORTAL_URL=https://portal.sqd.dev/datasets/polygon-mainnet
SQD_PORTAL_API_KEY=
