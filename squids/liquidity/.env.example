# local development defaults — copy to .env and fill in the secrets
DB_NAME=squid
DB_USER=postgres
DB_PASS=postgres
# 23801, alongside predict-polymarket 23798, pearl-transactions 23799, service-registry 23800
DB_PORT=23801
DB_HOST=localhost
# Which chain this deployment indexes: a key of CHAINS in src/constants.ts.
LIQUIDITY_CHAIN=robinhood
# SQD Portal dataset URL + key. Public datasets need no key; robinhood-mainnet
# is private, so both are required there.
SQD_PORTAL_URL=https://portal.sqd.dev/datasets/robinhood-mainnet
SQD_PORTAL_API_KEY=
# JSON-RPC for the contract reads: Balancer pool id / tokens / balances at the
# event's block on mint and burn, Uniswap V2 token0/token1 once, and the
# Chainlink native/USD feed. Archive-capable preferred for a backfill.
RPC_HTTP=https://rpc.mainnet.chain.robinhood.com
RPC_HTTP_FALLBACK=
