DB_NAME=squid
DB_USER=postgres
DB_PASS=postgres
DB_PORT=23811
DB_HOST=localhost
GQL_PORT=4350
# Unset: portal when a key is present, RPC otherwise. The public base-mainnet
# dataset needs no key but rate-limits a backfill: set INGEST_SOURCE=portal.
INGEST_SOURCE=
# Must serve historical eth_call / eth_getCode / eth_getLogs (archive).
# Reads never fall back to latest. Keyless default: https://mainnet.base.org
RPC_HTTP=https://mainnet.base.org
RPC_RATE_LIMIT=10
SQD_PORTAL_URL=https://portal.sqd.dev/datasets/base-mainnet
SQD_PORTAL_API_KEY=
# Optional: stop at this block (parity runs at a pinned head).
BABYDEGEN_TO_BLOCK=
