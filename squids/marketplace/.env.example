# local development defaults — copy to .env and fill in the secrets
DB_NAME=squid
DB_USER=postgres
DB_PASS=postgres
# 23801, so a local marketplace DB can run alongside predict-polymarket's
# 23798, pearl-transactions' 23799 and service-registry's 23800
DB_PORT=23801
DB_HOST=localhost
# Which chain this deployment indexes (key into CHAINS in src/constants.ts).
MARKETPLACE_CHAIN=robinhood
# Where blocks come from: "portal" (SQD Portal) or "rpc" (the chain's
# JSON-RPC). Unset = portal when SQD_PORTAL_API_KEY is set, rpc otherwise.
# robinhood-mainnet is a PRIVATE portal dataset (the public portal answers
# 404), so without the key below the squid ingests over RPC — slower on a
# backfill, fine at the head, and enough for the empty Robinhood history.
INGEST_SOURCE=
# JSON-RPC endpoint for the chain above. Two uses: (1) always, the Chainlink
# ETH/USD read behind the fee->USD conversion — archive-capable preferred,
# reads are pinned to the event's block and fall back to "latest" when the
# node cannot serve it; (2) event ingestion when INGEST_SOURCE=rpc.
# The official endpoint is pruned (~minutes of state) and rate-limited;
# https://rpc-gate.autonolas.tech/robinhood-rpc/ is archive-capable — see README.
RPC_HTTP=https://rpc.mainnet.chain.robinhood.com
# Optional second endpoint for the Chainlink read, tried when the primary
# fails with a non-revert error at the pinned block (pruned state, hole).
RPC_HTTP_FALLBACK=
# Optional requests/second cap for RPC ingestion (public endpoints 429).
RPC_RATE_LIMIT=
# SQD Portal dataset URL + private key. Production sets both from the infra
# secret; leave the key empty to ingest over RPC instead.
SQD_PORTAL_URL=https://portal.sqd.dev/datasets/robinhood-mainnet
SQD_PORTAL_API_KEY=
