DB_NAME=squid
DB_USER=postgres
DB_PASS=postgres
DB_PORT=23805
DB_HOST=localhost
GQL_PORT=4350
# robinhood (default) or base. Base: SQD_PORTAL_URL=.../datasets/base-mainnet
# (key optional on the public portal, which rate-limits a backfill).
# SQD_PORTAL_URL must name the selected chain's dataset or startup fails.
# Keyless public portal: set INGEST_SOURCE=portal (unset + no key = RPC ingestion).
TOKENOMICS_CHAIN=robinhood
# Unset: portal when a key is present, RPC otherwise.
INGEST_SOURCE=
# Used for event ingestion when INGEST_SOURCE=rpc.
RPC_HTTP=https://rpc-gate.autonolas.tech/robinhood-rpc/
RPC_RATE_LIMIT=10
SQD_PORTAL_URL=https://portal.sqd.dev/datasets/robinhood-mainnet
SQD_PORTAL_API_KEY=
