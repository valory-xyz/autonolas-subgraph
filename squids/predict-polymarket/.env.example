# local development defaults — copy to .env and fill in the secrets
DB_NAME=squid
DB_USER=postgres
DB_PASS=postgres
DB_PORT=23798
DB_HOST=localhost
# RPC for the getCollectionId eth_call (not used for event ingestion).
RPC_POLYGON_HTTP=https://polygon-rpc.com
# SQD Portal dataset URL. The default public portal needs no key.
# Production overrides both vars with the private portal URL + key.
SQD_PORTAL_URL=https://portal.sqd.dev/datasets/polygon-mainnet
SQD_PORTAL_API_KEY=
