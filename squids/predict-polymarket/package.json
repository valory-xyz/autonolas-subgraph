{
  "name": "predict-polymarket-squid",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "rm -rf lib && tsc",
    "codegen": "squid-typeorm-codegen",
    "typegen": "squid-evm-typegen src/abi ../../abis/ServiceRegistryL2.json ../../abis/ConditionalTokens.json ../../abis/OptimisticOracleV3.json ../../abis/UmaCtfAdapter.json ../../abis/NegRiskAdapter.json ../../abis/CTFExchange.json ../../abis/CTFExchangeV2.json ../../abis/CtfCollateralAdapter.json ../../abis/DepositWalletFactory.json --multicall",
    "migration:generate": "squid-typeorm-migration generate",
    "migration:apply": "squid-typeorm-migration apply",
    "process": "node lib/main.js",
    "serve": "squid-graphql-server",
    "test": "vitest run"
  },
  "dependencies": {
    "@subsquid/evm-abi": "1.0.0",
    "@subsquid/evm-codec": "1.0.0",
    "@subsquid/evm-processor": "1.30.1",
    "@subsquid/graphql-server": "4.12.1",
    "@subsquid/typeorm-migration": "1.4.0",
    "@subsquid/typeorm-store": "1.9.1",
    "dotenv": "16.4.5",
    "pg": "8.16.0",
    "typeorm": "0.3.31",
    "viem": "2.55.10"
  },
  "devDependencies": {
    "@subsquid/evm-typegen": "5.0.0",
    "@subsquid/typeorm-codegen": "2.4.0",
    "@types/node": "24.12.2",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}