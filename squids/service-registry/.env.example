# local development defaults — copy to .env and fill in the secrets
DB_NAME=squid
DB_USER=postgres
DB_PASS=postgres
# 23800, so a local service-registry DB can run alongside the other squids
# (predict-polymarket 23798, pearl-transactions 23799)
DB_PORT=23800
DB_HOST=localhost
# robinhood-mainnet is NOT on the public portal listing — it is a private
# dataset enabled for Olas by the SQD team. The key is required (the
# processor refuses to start without it); ask infra, never commit it.
SQD_PORTAL_URL=https://portal.sqd.dev/datasets/robinhood-mainnet
SQD_PORTAL_API_KEY=
# No RPC: this squid reads no contract state, only event logs.
