# CODEOWNERS for autonolas-subgraph
#
# This file routes review of security- and supply-chain-sensitive files
# to the security reviewer(s). Enforcement requires "Require review from
# Code Owners" in branch protection settings — until that is enabled
# this file is advisory and only nudges GitHub's PR review-request UI.
#
# Owner is an individual until a security team exists; switch to a team
# handle (e.g., @valory-xyz/<team>) once one is created.

# Default owner: any unowned path falls back here.
*                                @atepem

# Workflows, actions config, repository-level GitHub config.
/.github/                        @atepem

# Top-level package metadata + lockfile.
/package.json                    @atepem
/yarn.lock                       @atepem

# Node-version pin enforced by Corepack in CI.
/.nvmrc                          @atepem

# Supply-chain controls: scripts that gate CI + allowlists they consult.
/scripts/                        @atepem
/.supply-chain/                  @atepem

# Disclosure + threat-model docs.
/SECURITY.md                     @atepem
/SUPPLY-CHAIN-SECURITY.md        @atepem

# AI / contributor onboarding context — changes here shape future agent behavior.
/CLAUDE.md                       @atepem

# Local-dev infra (postgres password lives here as env-var requirement).
/docker-compose.yaml             @atepem

# Per-subgraph package metadata + lockfiles.
/subgraphs/*/package.json        @atepem
/subgraphs/*/yarn.lock           @atepem

# Per-subgraph manifests — contract addresses + start blocks live here.
# These deserve security review because a malicious manifest edit could
# index events from a malicious contract address with the same signature
# as a legitimate one.
/subgraphs/*/subgraph.yaml       @atepem
/subgraphs/*/subgraph.*.yaml     @atepem
