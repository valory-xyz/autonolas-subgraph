node_modules
data/
build/
generated/
# squids commit their generated code (models, ABI decoders) — the
# Docker/CI builds compile from it and cannot regenerate (shared ABIs
# live outside the build context)
!squids/**/generated/
temp/
# matchstick `graph test -d` (Docker mode) build artifact
**/tests/.docker/

.env
.env.prod
.env.local

.DS_Store
.bin
.latest.json

# IDE
.idea/
.cursor/
.vscode/

# Claude Code
.claude/projects/
.claude/settings.local.json

/.plans

# Other-package-manager lockfiles (this repo uses yarn 1.x)
package-lock.json
# squids are npm packages — their lockfiles are the audited source of truth
!squids/**/package-lock.json
pnpm-lock.yaml
bun.lockb

# Tier-0 audit baseline drop (gitignored; informational only)
/audit

# yarn-generated error logs from failed installs/audits
yarn-error.log
**/yarn-error.log
